# =============================================
# 忽略整個 output_files 底下的所有編譯暫存
# (使用 output_files/* 保留資料夾結構，才能用 ! 救回燒錄檔)
# =============================================
output_files/*

# 強制保留 output_files 底下的燒錄檔與腳位報告
!output_files/*.sof
!output_files/*.pof
!output_files/*.jic
!output_files/*.hex
!output_files/*.ttf
!output_files/*.jam
!output_files/*.jbc
!output_files/*.pin

# =============================================
# 忽略 Quartus 大型編譯資料庫與暫存目錄
# =============================================
db/
incremental_db/
simulation/
greybox/
hc_output/
.qsys_edit/
hdl_sim/
timing/
.tmp/

# =============================================
# 忽略各種編譯記錄檔、報告與系統暫存檔
# =============================================
*.rpt
*.summary
*.smsg
*.done
*.qdf
*.log
*.jdi
*.sld
*.sopcinfo
*.html
*.eqn
*.qmsg
*.svf
*.map
*.asm.rpt
*.fit.rpt
*.sta.rpt
*.eda.rpt

# 備份檔與使用者工作區紀錄
*.bak
*.qarlog
*.qws
*~

# =============================================
# 白名單：明確保留核心專案、腳位與特定網表檔
# =============================================
!*.qpf
!*.qsf
!atom_netlists/
!atom_netlists/**